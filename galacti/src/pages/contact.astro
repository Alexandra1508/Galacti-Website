---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { blue, grey, alt } from '../data/media';
import { legal, social } from '../data/site';

// Set PUBLIC_FORM_ENDPOINT in .env when connecting a form delivery service.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---

<BaseLayout
  title="Experiência Privada"
  current="contact"
  theme="blue"
  description="Entre no universo GALACTI — Solicite uma experiência privada para o Cosmic Blue ou Eclipse Grey."
>
  <!-- ============ HERO ============ -->
  <section class="hero" data-hero>
    <div class="hero-img">
      <Photo src={blue.doors} alt={alt.doors} sizes="100vw" eager />
      <div class="hero-shade" aria-hidden="true"></div>
    </div>
    <canvas class="stars" data-starfield data-tint="blue" data-density="0.35" aria-hidden="true"></canvas>
    <div class="wrap hero-in">
      <span class="eyebrow" data-reveal="fade">Experiência Privada</span>
      <h1 class="display" data-split>ENTRE NO UNIVERSO<br /><em>GALACTI</em>.</h1>
      <p class="hero-sub serif" data-reveal="up" data-delay="180">Uma experiência além do extraordinário.</p>
    </div>
  </section>

  <!-- ============ SEÇÃO (01) — SOLICITAÇÃO PRIVADA & PREFERÊNCIA ============ -->
  <section class="section" id="request">
    <div class="wrap">
      <div class="fx-section-bar" data-reveal="fade">
        <span>01 · Experiência Privada &amp; Correspondência</span>
        <span>(01)</span>
      </div>
      <div class="fx-section-rule" aria-hidden="true"></div>

      <div class="contact-grid">
        <div class="left-col" data-reveal="up">
          <h2 class="h2">Inicie uma conversa <em>privada.</em></h2>
          <p class="lead">
            Selecione a expressão que traduz seu olhar e compartilhe algumas palavras. Cada solicitação é preparada para atendimento direto pela casa GALACTI no lançamento.
          </p>

          <!-- Cartões Selecionáveis de Preferência de Edição -->
          <div class="pref-grid" role="group" aria-label="Edição GALACTI de preferência">
            <button type="button" class="pref-card fx-card border-gradient is-selected" data-pref="Cosmic Blue" aria-pressed="true">
              <div class="pref-thumb frame">
                <Photo src={blue.front} alt={alt.front} sizes="160px" />
              </div>
              <div class="pref-meta">
                <span class="caption">Edição 01</span>
                <strong>Cosmic Blue</strong>
              </div>
            </button>

            <button type="button" class="pref-card fx-card border-gradient" data-pref="Eclipse Grey" aria-pressed="false">
              <div class="pref-thumb frame">
                <Photo src={grey.front} alt={alt.greyFront} sizes="160px" />
              </div>
              <div class="pref-meta">
                <span class="caption">Edição 02</span>
                <strong>Eclipse Grey</strong>
              </div>
            </button>

            <button type="button" class="pref-card fx-card border-gradient" data-pref="Ambas as Expressões" aria-pressed="false">
              <div class="pref-thumb frame dual-thumb">
                <Photo src={blue.profile} alt="" decorative sizes="160px" />
              </div>
              <div class="pref-meta">
                <span class="caption">Dualidade</span>
                <strong>Ambas as Edições</strong>
              </div>
            </button>
          </div>

          <dl class="inst-details">
            <div>
              <dt class="caption">Contato Institucional</dt>
              <dd>Canal direto de concierge a ser anunciado</dd>
            </div>
            <div>
              <dt class="caption">Perfis Oficiais</dt>
              <dd class="soc">
                {
                  social.map((s) =>
                    s.url ? (
                      <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
                    ) : (
                      <span class="off" title="Perfil oficial a ser anunciado">{s.label}</span>
                    ),
                  )
                }
              </dd>
            </div>
          </dl>
        </div>

        <form
          class="form fx-card border-gradient"
          id="contact-form"
          method="post"
          action={endpoint || undefined}
          data-endpoint={endpoint}
          novalidate
          data-reveal="up"
          data-delay="120"
        >
          <input type="hidden" name="edition" id="f-edition" value="Cosmic Blue" />

          <div class="form-head">
            <span class="caption">Interesse Selecionado</span>
            <strong id="selected-edition-label">GALACTI Cosmic Blue</strong>
          </div>

          <div class="field">
            <input id="f-name" name="name" type="text" autocomplete="name" placeholder=" " required />
            <label for="f-name">Nome</label>
            <i></i>
            <span class="err" data-for="f-name"></span>
          </div>

          <div class="field">
            <input id="f-email" name="email" type="email" autocomplete="email" placeholder=" " required />
            <label for="f-email">E-mail</label>
            <i></i>
            <span class="err" data-for="f-email"></span>
          </div>

          <div class="field">
            <input id="f-country" name="country" type="text" autocomplete="country-name" placeholder=" " required />
            <label for="f-country">País</label>
            <i></i>
            <span class="err" data-for="f-country"></span>
          </div>

          <div class="field">
            <textarea id="f-msg" name="message" rows="4" placeholder=" " required></textarea>
            <label for="f-msg">Mensagem</label>
            <i></i>
            <span class="err" data-for="f-msg"></span>
          </div>

          <div class="hp" aria-hidden="true">
            <label>Empresa <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
          </div>

          <label class="consent">
            <input type="checkbox" name="consent" id="f-consent" required />
            <span>Concordo em ser contatado a respeito da GALACTI. Consulte nossa <a href="/privacy/">Política de Privacidade</a>.</span>
          </label>
          <span class="err" data-for="f-consent"></span>

          <div class="submit-row">
            <button type="submit" class="pill-btn pill-btn-primary" id="send">
              <span>Enviar Solicitação</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </button>
            <p class="status" id="form-status" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- ============ SEÇÃO (02) — HORIZONTE DUPLO FINAL ============ -->
  <section class="section">
    <div class="wrap">
      <div class="fx-section-bar" data-reveal="fade">
        <span>02 · Duas Expressões · Um Universo</span>
        <span>(02)</span>
      </div>
      <div class="fx-section-rule" aria-hidden="true"></div>

      <div class="duo-grid">
        <a href="/cosmic-blue/" class="duo-card fx-card border-gradient" data-reveal="up">
          <div class="duo-img frame">
            <Photo src={blue.rear} alt={alt.rear} sizes="(min-width: 800px) 44vw, 94vw" />
          </div>
          <div class="duo-meta">
            <span class="caption">Expressão 01</span>
            <h3 class="h3">Cosmic Blue</h3>
          </div>
        </a>

        <a href="/eclipse-grey/" class="duo-card fx-card border-gradient" data-reveal="up" data-delay="120">
          <div class="duo-img frame">
            <Photo src={grey.front} alt={alt.greyFront} sizes="(min-width: 800px) 44vw, 94vw" />
          </div>
          <div class="duo-meta">
            <span class="caption">Expressão 02</span>
            <h3 class="h3">Eclipse Grey</h3>
          </div>
        </a>
      </div>

      <nav class="quick-nav" aria-label="Links legais e de exploração">
        <a href="/design/" class="link-arrow">Design &amp; Manufatura <span class="rule"></span></a>
        <a href="/universe/" class="link-arrow">O Universo Galacti <span class="rule"></span></a>
        {legal.map((l) => <a href={l.href} class="link-arrow">{l.label} <span class="rule"></span></a>)}
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 78vh;
    display: grid;
    align-items: end;
    overflow: hidden;
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(3rem, 8vh, 5.5rem);
  }
  .hero-img {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(5, 6, 11, 0.94) 0%, rgba(5, 6, 11, 0.45) 55%, rgba(5, 6, 11, 0.5) 100%);
  }
  .stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero-in {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.2rem;
  }
  .hero-sub {
    font-size: clamp(1.15rem, 1.9vw, 1.65rem);
    font-style: italic;
    color: var(--champagne);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  .left-col {
    display: grid;
    gap: 1.5rem;
  }

  .pref-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-top: 0.5rem;
  }
  @media (max-width: 580px) {
    .pref-grid {
      grid-template-columns: 1fr;
    }
  }
  .pref-card {
    padding: 0.55rem;
    display: grid;
    gap: 0.65rem;
    text-align: left;
    border-radius: 18px;
    opacity: 0.7;
    transition:
      opacity 0.3s ease,
      transform 0.35s var(--ease),
      box-shadow 0.35s ease;
  }
  .pref-card:hover,
  .pref-card.is-selected {
    opacity: 1;
    transform: translateY(-2px);
    box-shadow: 0 14px 36px var(--accent-soft);
  }
  .pref-card.is-selected {
    background: rgba(255, 255, 255, 0.085);
  }
  .pref-thumb {
    aspect-ratio: 16 / 10;
    border-radius: 12px;
  }
  .pref-meta {
    padding: 0.1rem 0.35rem 0.3rem;
  }
  .pref-meta strong {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .inst-details {
    margin-top: 0.75rem;
    display: grid;
  }
  .inst-details > div {
    display: grid;
    gap: 0.35rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }
  .inst-details > div:last-child {
    border-bottom: 1px solid var(--line);
  }
  .inst-details dd {
    margin: 0;
    color: var(--secondary);
    font-size: 0.9rem;
  }
  .soc {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .soc .off {
    color: rgba(226, 232, 240, 0.44);
  }

  /* Form */
  .form {
    padding: clamp(1.75rem, 3.5vw, 3rem);
    display: grid;
    gap: 1.75rem;
  }
  .form-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .form-head strong {
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--champagne);
  }
  .field {
    position: relative;
    padding-top: 1.1rem;
  }
  .field input,
  .field textarea {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    padding: 0.65rem 0;
    color: var(--ice);
    font: inherit;
    font-size: 1rem;
    outline: none;
    resize: vertical;
  }
  .field label {
    position: absolute;
    left: 0;
    top: 1.8rem;
    font-size: 0.68rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--muted);
    pointer-events: none;
    transition:
      translate 0.45s var(--ease),
      scale 0.45s var(--ease),
      color 0.3s ease;
    transform-origin: left;
  }
  .field input:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label,
  .field textarea:not(:placeholder-shown) + label {
    translate: 0 -1.55rem;
    scale: 0.88;
    color: var(--accent-strong);
  }
  .field i {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 100%;
    background: var(--accent-strong);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.6s var(--ease);
  }
  .field input:focus ~ i,
  .field textarea:focus ~ i {
    scale: 1 1;
  }
  .field.invalid input,
  .field.invalid textarea {
    border-color: #f87171;
  }
  .err {
    display: block;
    min-height: 1rem;
    margin-top: 0.35rem;
    font-size: 0.74rem;
    color: #fca5a5;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .consent {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    font-size: 0.84rem;
    color: var(--muted);
    cursor: pointer;
  }
  .consent input {
    appearance: none;
    flex: 0 0 auto;
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.2rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    display: grid;
    place-content: center;
  }
  .consent input::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--accent-strong);
    scale: 0;
    transition: scale 0.3s var(--ease);
  }
  .consent input:checked::after {
    scale: 1;
  }
  .consent a {
    color: var(--ice);
    border-bottom: 1px solid var(--line-strong);
  }
  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }
  .status {
    font-size: 0.85rem;
    color: var(--muted);
    max-width: 26rem;
  }
  .status.ok {
    color: var(--accent-strong);
  }
  .status.warn {
    color: var(--champagne);
  }

  /* Duo finale */
  .duo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }
  @media (max-width: 820px) {
    .duo-grid {
      grid-template-columns: 1fr;
    }
  }
  .duo-card {
    padding: 0.75rem;
    display: grid;
    gap: 0.9rem;
    transition: transform 0.45s var(--ease);
  }
  .duo-card:hover {
    transform: translateY(-4px);
  }
  .duo-img {
    aspect-ratio: 16 / 10;
    border-radius: 18px;
  }
  .duo-meta {
    padding: 0.25rem 0.65rem 0.65rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .quick-nav {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2.5rem;
  }
</style>

<script>
  const prefCards = document.querySelectorAll<HTMLButtonElement>('.pref-card');
  const editionInput = document.getElementById('f-edition') as HTMLInputElement | null;
  const editionLabel = document.getElementById('selected-edition-label');

  prefCards.forEach((card) => {
    card.addEventListener('click', () => {
      const val = card.dataset.pref ?? 'Cosmic Blue';
      prefCards.forEach((c) => {
        const on = c === card;
        c.classList.toggle('is-selected', on);
        c.setAttribute('aria-pressed', String(on));
      });
      if (editionInput) editionInput.value = val;
      if (editionLabel) editionLabel.textContent = `GALACTI ${val}`;
    });
  });

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const btn = document.getElementById('send') as HTMLButtonElement | null;

  const messages: Record<string, string> = {
    name: 'Por favor, informe seu nome.',
    email: 'Por favor, informe um e-mail válido.',
    country: 'Por favor, informe seu país.',
    message: 'Por favor, escreva uma breve mensagem.',
    consent: 'Por favor, confirme para continuar.',
  };

  function validate(f: HTMLFormElement) {
    let ok = true;
    f.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]').forEach((el) => {
      const valid = el.type === 'checkbox' ? (el as HTMLInputElement).checked : el.checkValidity() && el.value.trim() !== '';
      const err = f.querySelector(`.err[data-for="${el.id}"]`);
      el.closest('.field')?.classList.toggle('invalid', !valid);
      el.setAttribute('aria-invalid', String(!valid));
      if (err) err.textContent = valid ? '' : (messages[el.name] ?? 'Campo obrigatório.');
      if (!valid) ok = false;
    });
    return ok;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !btn) return;
    status.className = 'status';
    status.textContent = '';
    if (!validate(form)) {
      (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus();
      return;
    }
    const data = new FormData(form);
    if (data.get('company')) return;
    const endpoint = form.dataset.endpoint;

    if (!endpoint) {
      status.classList.add('warn');
      status.textContent = 'Formulário validado e pronto para integração (defina PUBLIC_FORM_ENDPOINT para envio ativo).';
      return;
    }

    btn.disabled = true;
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.classList.add('ok');
      status.textContent = 'Obrigado. Sua solicitação privada foi recebida.';
    } catch {
      status.classList.add('warn');
      status.textContent = 'Não foi possível enviar no momento. Tente novamente em instantes.';
    } finally {
      btn.disabled = false;
    }
  });

  form?.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    t.closest('.field')?.classList.remove('invalid');
    const err = form.querySelector(`.err[data-for="${t.id}"]`);
    if (err) err.textContent = '';
  });
</script>
