---
import Photo from './Photo.astro';
import { blue, grey, alt } from '../data/media';

interface Props {
  shot: 'profile' | 'front' | 'interior' | 'doors' | 'rear';
  greyShot?: 'front' | 'profile' | 'track' | 'rear' | 'fender' | 'wheel' | 'exhaust' | 'mist';
  sizes?: string;
  label?: string;
  eager?: boolean;
  class?: string;
}
const {
  shot,
  greyShot,
  sizes = '100vw',
  label,
  eager = false,
  class: cls = '',
} = Astro.props;

const resolvedGrey =
  greyShot ??
  (shot === 'front'
    ? 'front'
    : shot === 'rear'
      ? 'rear'
      : shot === 'profile'
        ? 'fender'
        : shot === 'doors'
          ? 'mist'
          : 'exhaust');
---

<div class={`dual ${cls}`}>
  <div class="layer v-blue">
    <Photo src={blue[shot]} alt={label ?? alt[shot]} sizes={sizes} eager={eager} />
  </div>
  <div class="layer v-grey">
    <Photo src={grey[resolvedGrey]} alt="" decorative sizes={sizes} eager={eager} />
  </div>
</div>

<style>
  .dual {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .layer {
    position: absolute;
    inset: 0;
    transition: opacity 0.85s var(--ease-in-out);
  }
  .layer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .v-grey {
    opacity: 0;
  }
  :global(body[data-finish='grey']) .v-grey {
    opacity: 1;
  }
  :global(body[data-finish='grey']) .v-blue {
    opacity: 0;
  }
</style>
