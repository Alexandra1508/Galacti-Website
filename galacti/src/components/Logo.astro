---
// GALACTI mark: a quiet planetary disc crossed by one tilted orbit and a single satellite.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls = '' } = Astro.props;
---

<svg
  class={`mark ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="24" cy="24" r="9.5" stroke="currentColor" stroke-width="1" opacity="0.95"></circle>
  <ellipse
    cx="24"
    cy="24"
    rx="21"
    ry="8.2"
    transform="rotate(-24 24 24)"
    stroke="currentColor"
    stroke-width="0.8"
    opacity="0.6"></ellipse>
  <circle cx="42.4" cy="15.6" r="1.9" fill="currentColor"></circle>
</svg>
