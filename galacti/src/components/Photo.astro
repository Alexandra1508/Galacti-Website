---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  pos?: string; // object-position
  zoomed?: boolean; // wrap in an oversized parallax layer
  parallax?: number;
  decorative?: boolean;
}
const {
  src,
  alt,
  sizes = '100vw',
  eager = true,
  class: cls = '',
  pos = 'center',
  zoomed = false,
  parallax = 0.06,
  decorative = false,
} = Astro.props;
const effectiveSizes = sizes.includes('160px') ? '600px' : '100vw';
---

{
  zoomed ? (
    <div class="zoom" data-parallax={parallax}>
      <Image
        src={src}
        alt={decorative ? '' : alt}
        widths={[1600, 2560]}
        sizes={effectiveSizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="sync"
        format="webp"
        quality={96}
        class:list={['galacti-photo', cls]}
        style={`object-position:${pos}`}
      />
    </div>
  ) : (
    <Image
      src={src}
      alt={decorative ? '' : alt}
      widths={[1600, 2560]}
      sizes={effectiveSizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding="sync"
      format="webp"
      quality={96}
      class:list={['galacti-photo', cls]}
      style={`object-position:${pos}`}
    />
  )
}
